# Fallback sample data (used only when the real files are missing/malformed)
# ---------------------------------------------------------------------------

SAMPLE_THREAT = 25
SAMPLE_FPS = "308"  # about the rate seen in the Oct 16 ecu_simulator recordings
SAMPLE_ROWS = [
    ("1791300000.123456", "0x0A0", "8", "3201000000000017", "OK"),
    ("1791300000.133502", "0x0B0", "8", "00FA000000000042", "OK"),
    ("1791300000.143611", "0x100", "8", "0BB5000000000009", "OK"),
    ("1791300042.501223", "0x0A0", "8", "6400000000000099", "ALERT"),
    ("1791300042.511400", "0x200", "8", "3C00000000000012", "OK"),
]

REQUIRED_ALERT_FIELDS = {
    "timestamp", "attack_type", "suspect_id", "confidence",
    "severity", "affected_system", "detection_layer", "technique",
}
REQUIRED_CSV_FIELDS = {"timestamp", "can_id", "dlc", "data_hex", "label"}
# CAN ID -> readable system name (project baseline)
ECU_NAMES = {
    0x0A0: "brake",
    0x0B0: "steering",
    0x100: "engine RPM",
    0x200: "vehicle speed",
    0x300: "engine temp",
    0x600: "infotainment",
    0x7DF: "diagnostics",
}


def ecu_name(can_id):
    """Return the readable system name for a known CAN ID."""
    try:
        return ECU_NAMES.get(int(str(can_id).strip(), 16))
    except (ValueError, TypeError):
        return None


# ---------------------------------------------------------------------------
# Loaders
# ---------------------------------------------------------------------------


def load_alert(path):
    """Load the latest valid alert from either a JSON object or JSONL file."""
    latest_alert = None

    try:
        with open(path, encoding="utf-8") as f:
            content = f.read().strip()
    except OSError:
        return None

    if not content:
        return None

    # Accept a regular JSON object first, then fall back to JSON Lines.
    try:
        parsed = json.loads(content)
        candidates = parsed if isinstance(parsed, list) else [parsed]
    except json.JSONDecodeError:
        candidates = []
        for line in content.splitlines():
            if not line.strip():
                continue
            try:
                candidates.append(json.loads(line))
            except json.JSONDecodeError:
                continue

    for alert in candidates:
        if not isinstance(alert, dict):
            continue
        if not REQUIRED_ALERT_FIELDS <= alert.keys():
            continue
        try:
            alert = dict(alert)
            alert["confidence"] = float(alert["confidence"])
        except (TypeError, ValueError, KeyError):
            continue
        latest_alert = alert

    return latest_alert


def load_alerts(path):
    """Load every valid alert record from the detector JSONL file."""
    alerts = []
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    item = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if not isinstance(item, dict) or not REQUIRED_ALERT_FIELDS <= item.keys():
                    continue
                try:
                    item = dict(item)
                    item["confidence"] = float(item["confidence"])
                except (TypeError, ValueError, KeyError):
                    continue
                alerts.append(item)
    except OSError:
        return []
    return alerts


def find_recording(data_dir):
    """Return the newest non-empty normal_run CSV recording."""
    try:
        files = [
            p for p in data_dir.glob("normal_run*_*.csv")
            if p.is_file() and p.stat().st_size > 0
        ]

        files.sort(
            key=lambda p: p.stat().st_mtime,
            reverse=True,
        )

    except OSError:
        return None

    return files[0] if files else None


def load_recording(path, n=5):
    """
    Reads a recorded CSV in one pass.

    Returns:
        (last_n_rows, frames_per_second, filename, clock_steps)
        or None if the file is invalid.

    FPS is calculated using forward-moving timestamp differences.
    Backward timestamp jumps are counted in clock_steps.
    """
    if path is None:
        return None

    tail = deque(maxlen=n)
    count = 0
    prev = None
    forward = 0.0
    clock_steps = 0

    try:
        with open(path, newline="", encoding="utf-8") as f:
            reader = csv.DictReader(f)

            if (
                not reader.fieldnames
                or not REQUIRED_CSV_FIELDS.issubset(set(reader.fieldnames))
            ):
                return None

            for r in reader:
                ts = float(r["timestamp"])

                if prev is not None:
                    delta = ts - prev

                    if delta >= 0:
                        forward += delta
                    else:
                        clock_steps += 1

                prev = ts
                count += 1

                status = "OK" if r["label"] == "normal" else "ALERT"

                tail.append((
                    r["timestamp"],
                    r["can_id"],
                    r["dlc"],
                    r["data_hex"],
                    status
                ))

    except (OSError, ValueError, KeyError, TypeError):
        return None

    if count < 2 or forward <= 0:
        return None

    fps = (count - 1) / forward
    return list(tail), fps, Path(path).name, clock_steps


_SERIES_CACHE = {}


def load_fps_series(path):
    """Frames per second for every second of the recording: (series, average).

    Uses the same forward-timestamp rule as load_recording, and is cached per
    file version so the 1-second refresh timer stays cheap.
    """
    if path is None:
        return [], 0.0
    try:
        st = Path(path).stat()
    except OSError:
        return [], 0.0
    key = (str(path), st.st_mtime, st.st_size)
    if key in _SERIES_CACHE:
        return _SERIES_CACHE[key]

    buckets = Counter()
    prev, elapsed, count = None, 0.0, 0
    try:
        with open(path, newline="", encoding="utf-8") as f:
            reader = csv.DictReader(f)
            if (
                not reader.fieldnames
                or not REQUIRED_CSV_FIELDS.issubset(set(reader.fieldnames))
            ):
                return [], 0.0
            for r in reader:
                ts = float(r["timestamp"])
                if prev is not None and ts - prev >= 0:
                    elapsed += ts - prev
                prev = ts
                count += 1
                buckets[int(elapsed)] += 1
    except (OSError, ValueError, KeyError, TypeError):
        return [], 0.0
    if not buckets:
        return [], 0.0

    series = [buckets.get(k, 0) for k in range(max(buckets) + 1)]
    if len(series) > 2:
        series = series[:-1]  # the last second is usually partial
    avg = (count - 1) / elapsed if elapsed > 0 and count > 1 else 0.0
    _SERIES_CACHE.clear()
    _SERIES_CACHE[key] = (series, avg)
    return series, avg


# Load everything once at start-up.
ALERT = load_alert(ALERT_FILE)
RECORDING_FILE = find_recording(DATA_DIR)
