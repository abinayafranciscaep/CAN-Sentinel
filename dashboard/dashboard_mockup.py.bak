def threat_level(score):
    """Map a 0-100 score to a label and a colour."""

    if score < 40:
        return "LOW", "#35E58B"

    if score < 70:
        return "MEDIUM", "#FFB547"

    return "HIGH", "#FF4D5E"


def severity_color(severity):
    """Colour for the severity word in the alert banner."""
    return {
        "low": "#35E58B",
        "medium": "#FFB547",
        "high": "#FF8A4D",
        "critical": "#FF5A66",
    }.get(str(severity).lower(), "#FF5A66")


class ClickableFrame(QFrame):
    """A QFrame that emits clicked() on a left click."""

    clicked = pyqtSignal()

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit()
        super().mousePressEvent(event)
class DonutChart(QWidget):
    """Interactive CAN-ID traffic distribution doughnut chart."""

    can_id_clicked = pyqtSignal(str)

    def __init__(self, parent=None):
        super().__init__(parent)
        self.data = []
        self.total = 0
        self.colors = [
            QColor("#20B8FF"),
            QColor("#36D6A0"),
            QColor("#FFB547"),
            QColor("#FF718B"),
            QColor("#A78BFA"),
            QColor("#F59E0B"),
            QColor("#55C2E8"),
            QColor("#9CA3AF"),
        ]
        self.setMinimumHeight(220)
        self.setMinimumWidth(360)

    def set_data(self, data, total):
        self.data = data
        self.total = total
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)

        if not self.data:
            painter.setPen(QColor("#8EA6C2"))
            painter.drawText(self.rect(), Qt.AlignmentFlag.AlignCenter,
                             "Waiting for CAN traffic...")
            return

        size = min(175, self.height() - 25)
        pie = QRectF(15, (self.height() - size) / 2, size, size)

        start = 0.0
        for i, (can_id, count) in enumerate(self.data):
            span = count / max(self.total, 1) * 360
            painter.setBrush(self.colors[i % len(self.colors)])
            painter.setPen(Qt.PenStyle.NoPen)
            painter.drawPie(pie, int(start * 16), int(span * 16))
            start += span

        # Doughnut center
        center_size = size * 0.55
        center = pie.center()
        painter.setBrush(QColor("#101E30"))
        painter.drawEllipse(
            QRectF(center.x() - center_size / 2,
                   center.y() - center_size / 2,
                   center_size, center_size)
        )

        painter.setPen(QColor("#FFFFFF"))
        painter.drawText(
            QRectF(center.x() - 45, center.y() - 18, 90, 36),
            Qt.AlignmentFlag.AlignCenter,
            str(self.total)
        )

        # Legend
        x = pie.right() + 20
        y = 25
        for i, (can_id, count) in enumerate(self.data):
            color = self.colors[i % len(self.colors)]
            painter.setBrush(color)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.drawRoundedRect(QRectF(x, y + 3, 10, 10), 3, 3)

            percentage = count / max(self.total, 1) * 100
            painter.setPen(QColor("#DCE8F7"))
            painter.drawText(
                int(x + 18), int(y + 13),
                f"{can_id} - {ecu_name(can_id) or 'Unknown ECU'}: {count} ({percentage:.1f}%)"
            )
            y += 23

        painter.end()

    def mousePressEvent(self, event):
        if not self.data:
            return

        size = min(175, self.height() - 25)
        center_x = 15 + size / 2
        center_y = self.height() / 2
        dx = event.position().x() - center_x
        dy = center_y - event.position().y()

        distance = (dx * dx + dy * dy) ** 0.5
        if distance < size * 0.225 or distance > size * 0.5:
            return

        angle = math.degrees(math.atan2(dy, dx)) % 360
        cumulative = 0

        for can_id, count in self.data:
            span = count / max(self.total, 1) * 360
            if cumulative <= angle < cumulative + span:
                self.can_id_clicked.emit(can_id)
                break
            cumulative += span

def make_card(title, value, color, size=30, tip=None):
    """Create a rounded metric card with a title and a large value.

    The value label is kept on card.value_label so it can be updated later.
    Pass tip to make the card clickable (hover highlight + tooltip).
    """

    card = ClickableFrame()
    card.setObjectName("card")
    card.setSizePolicy(
        QSizePolicy.Policy.Expanding,
        QSizePolicy.Policy.Fixed,
    )

    box = QHBoxLayout(card)
    box.setContentsMargins(14, 12, 14, 12)
    box.setSpacing(12)

    # Decorative symbols only; these are not live system indicators.
    symbols = {
        "Frames / second": "∿",
        "Alerts loaded": "!",
        "Threat level": "✓",
    }

    symbol = QLabel(symbols.get(title.replace(" (sample)", ""), "•"))
    symbol.setAlignment(Qt.AlignmentFlag.AlignCenter)
    symbol.setFixedSize(48, 48)
    symbol.setStyleSheet(
        f"background-color: #172D46;"
        f"color: {color};"
        "border-radius: 10px;"
        "font-size: 24px;"
        "font-weight: bold;"
    )

    text_box = QVBoxLayout()
    text_box.setSpacing(3)

    title_label = QLabel(title)
    title_label.setObjectName("cardTitle")

    value_label = QLabel(value)
    value_label.setObjectName("cardValue")
    value_label.setStyleSheet(
        f"color: {color}; font-size: {size}px; font-weight: bold;"
    )

    text_box.addWidget(title_label)
    text_box.addWidget(value_label)

    box.addWidget(symbol)
    box.addLayout(text_box, 1)

    card.value_label = value_label
    if tip:
        card.setProperty("clickable", True)
        card.setCursor(Qt.CursorShape.PointingHandCursor)
        card.setToolTip(tip)

    return card


class FpsChart(QWidget):
    """Frames-per-second line chart with a hover read-out."""

    LEFT, RIGHT, TOP, BOTTOM = 40, 10, 8, 20

    def __init__(self):
        super().__init__()
        self.full = []
        self.series = []
        self.window = 60  # seconds shown; 0 = whole recording
        self.avg = None
        self.hover = None
        self.setMinimumHeight(150)
        self.setMouseTracking(True)

    def set_series(self, series, avg=None):
        self.full, self.avg = list(series), avg
        self._apply()

    def set_window(self, seconds):
        self.window = seconds
        self.hover = None
        self._apply()

    def _apply(self):
        self.series = self.full[-self.window:] if self.window else self.full
        if self.hover is not None and self.hover >= len(self.series):
            self.hover = None
        self.update()

    def mouseMoveEvent(self, event):
        n = len(self.series)
        pw = self.width() - self.LEFT - self.RIGHT
        if n >= 2 and pw > 0:
            i = round((event.position().x() - self.LEFT) / pw * (n - 1))
            self.hover = max(0, min(n - 1, i))
            self.update()

    def leaveEvent(self, event):
        self.hover = None
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        w, h = self.width(), self.height()
        pw, ph = w - self.LEFT - self.RIGHT, h - self.TOP - self.BOTTOM
        p.setFont(QFont(self.font().family(), 8))
        n = len(self.series)
        if n < 2 or pw <= 0 or ph <= 0:
            p.setPen(QColor("#6F89A7"))
            p.drawText(
                self.rect(),
                Qt.AlignmentFlag.AlignCenter,
                "Waiting for live CAN frames..."
            )
            p.end()
            return

        hi = (max(self.series) * 1.15) or 1

        def xy(i, v):
            return (self.LEFT + pw * i / (n - 1), self.TOP + ph * (1 - v / hi))

        for g in range(5):
            y = self.TOP + ph * g / 4
            p.setPen(QPen(QColor("#203B59"), 1))
            p.drawLine(self.LEFT, int(y), self.LEFT + pw, int(y))
            p.setPen(QColor("#6F89A7"))
            p.drawText(
                0, int(y) - 7, self.LEFT - 6, 14,
                Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                f"{hi * (4 - g) / 4:.0f}",
            )

        line = QPainterPath()
        for i, v in enumerate(self.series):
            x, y = xy(i, v)
            line.moveTo(x, y) if i == 0 else line.lineTo(x, y)
        area = QPainterPath(line)
        area.lineTo(self.LEFT + pw, self.TOP + ph)
        area.lineTo(self.LEFT, self.TOP + ph)
        area.closeSubpath()
        grad = QLinearGradient(0, self.TOP, 0, self.TOP + ph)
        grad.setColorAt(0, QColor(32, 184, 255, 90))
        grad.setColorAt(1, QColor(32, 184, 255, 0))
        p.fillPath(area, QBrush(grad))
        p.setPen(QPen(QColor("#20B8FF"), 2))
        p.drawPath(line)

        if self.avg:
            y = self.TOP + ph * (1 - self.avg / hi)
            p.setPen(QPen(QColor("#FFB547"), 1, Qt.PenStyle.DashLine))
            p.drawLine(self.LEFT, int(y), self.LEFT + pw, int(y))

        p.setPen(QColor("#6F89A7"))
        p.drawText(self.LEFT, h - 16, pw, 14, Qt.AlignmentFlag.AlignLeft, f"{n} s ago")
        p.drawText(self.LEFT, h - 16, pw, 14, Qt.AlignmentFlag.AlignRight, "latest")

        if self.hover is not None:
            x, y = xy(self.hover, self.series[self.hover])
            p.setPen(QPen(QColor("#9FB4CE"), 1, Qt.PenStyle.DotLine))
            p.drawLine(int(x), self.TOP, int(x), self.TOP + ph)
            p.setBrush(QColor("#20B8FF"))
            p.setPen(QPen(QColor("#FFFFFF"), 1))
            p.drawEllipse(int(x) - 4, int(y) - 4, 8, 8)
            text = f"{self.series[self.hover]} fps  ({n - 1 - self.hover} s ago)"
            tw = p.fontMetrics().horizontalAdvance(text) + 14
            bx = min(max(int(x) - tw // 2, self.LEFT), self.LEFT + pw - tw)
            p.setPen(QPen(QColor("#20B8FF"), 1))
            p.setBrush(QColor("#101F33"))
            p.drawRoundedRect(bx, self.TOP + 2, tw, 20, 5, 5)
            p.setPen(QColor("#DCE8F7"))
            p.drawText(bx, self.TOP + 2, tw, 20, Qt.AlignmentFlag.AlignCenter, text)


class HeroPanel(QWidget):
    """
    Top section of the dashboard. It paints the car image onto the navy
    background so the car merges into the page instead of sitting in a box:

    - Screen blend mode makes the image's black background disappear.
    - Soft alpha fades on the left, top, bottom and right edges remove any
      hard edge that is left.

    The title, cards and gauge are normal child widgets in this panel's
    layout. Its right margin is kept clear so they do not sit on the car.
    """

    BACKGROUND = QColor("#07111F")
    CAR_SHARE = 0.38      # fraction of the panel width reserved for the car

    def __init__(self, pixmap):
        super().__init__()
        self.setObjectName("hero")
        self._source = pixmap
        self._car = None
        self._car_size = None

    def _build_car(self, box_w, box_h):
        """Scale the car to fit the box and fade its edges to transparent."""
        scaled = self._source.scaled(
            QSize(box_w, box_h),
            Qt.AspectRatioMode.KeepAspectRatio,
            Qt.TransformationMode.SmoothTransformation,
        )
        img = QImage(scaled.size(), QImage.Format.Format_ARGB32_Premultiplied)
        img.fill(Qt.GlobalColor.transparent)

        painter = QPainter(img)
        painter.drawPixmap(0, 0, scaled)

        # DestinationIn multiplies the image alpha by the gradient alpha.
        painter.setCompositionMode(
            QPainter.CompositionMode.CompositionMode_DestinationIn
        )

        def fade(x1, y1, stops):
            grad = QLinearGradient(0, 0, x1, y1)
            for position, alpha in stops:
                grad.setColorAt(position, QColor(0, 0, 0, alpha))
            painter.fillRect(img.rect(), QBrush(grad))

        # left edge fades in, right edge fades out
        fade(img.width(), 0, [(0.0, 0), (0.30, 255), (0.88, 255), (1.0, 0)])
        # top and bottom fade out
        fade(0, img.height(), [(0.0, 0), (0.12, 255), (0.86, 255), (1.0, 0)])

        painter.end()
        return img

    def resizeEvent(self, event):
        """Keep the content column clear of the car as the window changes."""
        super().resizeEvent(event)
        layout = self.layout()
        if layout is not None:
            layout.setContentsMargins(
                0, 8, int(self.width() * self.CAR_SHARE), 8
            )

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.fillRect(self.rect(), self.BACKGROUND)

        if self._source.isNull():
            painter.setPen(QColor("#9FB4CE"))
            painter.drawText(
                self.rect().adjusted(self.width() // 2, 0, 0, 0),
                Qt.AlignmentFlag.AlignCenter,
                "CAR IMAGE NOT FOUND\n"
                "dashboard/assets/can_sentinel_car.png",
            )
            return

        box_w = int(self.width() * (self.CAR_SHARE + 0.06))
        box_h = self.height()
        if box_w < 10 or box_h < 10:
            return

        if self._car is None or self._car_size != (box_w, box_h):
            self._car = self._build_car(box_w, box_h)
            self._car_size = (box_w, box_h)

        x = self.width() - self._car.width()
        y = (self.height() - self._car.height()) // 2

        painter.setCompositionMode(
            QPainter.CompositionMode.CompositionMode_Screen
        )
        painter.drawImage(x, y, self._car)

class CANSocketReceiver(QThread):
    frame_received = pyqtSignal(dict)
    connection_changed = pyqtSignal(bool, str)

    def __init__(self, socket_path="/tmp/can_sentinel_fanout.sock"):
        super().__init__()
        self.socket_path = socket_path
        self.running = True

    def run(self):
        if not hasattr(socket, "AF_UNIX"):
            self.connection_changed.emit(
            False,
            "Live CAN socket requires Linux/WSL. Showing recorded data."
            )
            return

        while self.running:
            client = None

            try:
                client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                client.settimeout(2)
                client.connect(self.socket_path)

                self.connection_changed.emit(
                    True, "Connected to CAN sniffer"
                )

                buffer = b""

                while self.running:
                    try:
                        chunk = client.recv(4096)

                        if not chunk:
                            break

                        buffer += chunk

                        while b"\n" in buffer:
                            line, buffer = buffer.split(b"\n", 1)

                            if not line.strip():
                                continue

                            try:
                                frame = json.loads(line.decode("utf-8"))

                                required = {
                                    "timestamp",
                                    "can_id",
                                    "dlc",
                                    "data_hex"
                                }

                                if not required.issubset(frame):
                                    continue

                                dlc = int(frame["dlc"])
                                data_hex = str(frame["data_hex"])

                                if not 0 <= dlc <= 8:
                                    continue

                                if len(data_hex) != dlc * 2:
                                    continue

                                frame["can_id"] = str(frame["can_id"])
                                frame["data_hex"] = data_hex.upper()

                                self.frame_received.emit(frame)

                            except (ValueError, TypeError, UnicodeDecodeError):
                                continue

                    except socket.timeout:
                        continue

                self.connection_changed.emit(
                    False, "CAN sniffer disconnected"
                )

            except OSError:
                self.connection_changed.emit(
                    False, "Waiting for CAN sniffer..."
                )

            finally:
                if client:
                    client.close()

            # Retry connection every 2 seconds
            for _ in range(20):
                if not self.running:
                    break
                time.sleep(0.1)

    def stop(self):
        self.running = False

class VehicleThreatWidget(QWidget):
    """Simple top-down vehicle schematic; highlights the latest alert's ECU zone."""

    system_clicked = pyqtSignal(str)

    ZONES = {
        "brake": ("0x0A0", "Brake system"),
        "steering": ("0x0B0", "Steering"),
        "engine": ("0x100", "Engine RPM"),
        "speed": ("0x200", "Vehicle speed"),
        "temperature": ("0x300", "Engine temperature"),
        "infotainment": ("0x600", "Infotainment"),
    }

    def __init__(self, parent=None):
        super().__init__(parent)
        self.latest_alert = None
        self.zone_rects = {}
        self.setMinimumHeight(245)
        self.setMinimumWidth(300)
        self.setToolTip("Highlighted areas are subsystem associations based on CAN ID, not physical fault localization.")

    @staticmethod
    def _zone_for_alert(alert):
        if not alert:
            return None
        can_id = str(alert.get("suspect_id", "")).strip().lower()
        mapping = {
            "0x0a0": "brake", "0x0b0": "steering", "0x100": "engine",
            "0x200": "speed", "0x300": "temperature", "0x600": "infotainment",
        }
        if can_id in mapping:
            return mapping[can_id]
        system = str(alert.get("affected_system", "")).lower()
        for key in ("brake", "steer", "engine", "speed", "temp", "infotainment"):
            if key in system:
                return {"steer": "steering", "temp": "temperature"}.get(key, key)
        return None

    def set_alerts(self, alerts):
        self.latest_alert = alerts[-1] if alerts else None
        self.update()

    def paintEvent(self, event):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        p.fillRect(self.rect(), QColor("#0B1727"))
        w, h = self.width(), self.height()
        cx = w * 0.50
        car_w = min(w * 0.34, 170)
        car_h = h * 0.82
        left, top = cx - car_w / 2, (h - car_h) / 2
        body = QRectF(left, top, car_w, car_h)

        # Wheels and vehicle body.
        wheel_w, wheel_h = car_w * 0.16, car_h * 0.19
        wheel_positions = [
            (left - wheel_w * .35, top + car_h * .19),
            (left + car_w - wheel_w * .65, top + car_h * .19),
            (left - wheel_w * .35, top + car_h * .67),
            (left + car_w - wheel_w * .65, top + car_h * .67),
        ]
        for x, y in wheel_positions:
            p.setPen(QPen(QColor("#52677F"), 1))
            p.setBrush(QColor("#172334"))
            p.drawRoundedRect(QRectF(x, y, wheel_w, wheel_h), 5, 5)
        p.setPen(QPen(QColor("#6E8AA8"), 2))
        p.setBrush(QColor("#142A40"))
        p.drawRoundedRect(body, car_w * .22, car_w * .22)

        # Glass/cabin and front/rear details.
        p.setPen(QPen(QColor("#34516D"), 1.5))
        p.setBrush(QColor("#203D58"))
        p.drawRoundedRect(QRectF(left + car_w*.17, top + car_h*.25, car_w*.66, car_h*.48), 16, 16)
        p.setBrush(QColor("#10243A"))
        p.drawRoundedRect(QRectF(left + car_w*.20, top + car_h*.29, car_w*.60, car_h*.16), 8, 8)
        p.drawRoundedRect(QRectF(left + car_w*.20, top + car_h*.54, car_w*.60, car_h*.15), 8, 8)

        # ---------------- Cockpit speedometer ----------------
        import math

        dial_size = min(car_w * 0.52, 58)
        dial_cx = max(dial_size / 2 + 10, left - dial_size * 0.72)
        dial_cy = top + car_h * 0.39
        dial = QRectF(
            dial_cx - dial_size / 2,
            dial_cy - dial_size / 2,
            dial_size,
            dial_size,
        )

        # Outer neon ring and dark instrument face
        p.setPen(QPen(QColor("#39C5FF"), 2))
        p.setBrush(QColor("#07182B"))
        p.drawEllipse(dial)

        p.setPen(QPen(QColor("#244C70"), 1))
        p.drawEllipse(dial.adjusted(4, 4, -4, -4))

        # Speedometer scale
        radius = dial_size * 0.37
        for angle in range(30, 151, 20):
            rad = math.radians(angle)
            x1 = dial_cx + math.cos(rad) * (radius - 4)
            y1 = dial_cy - math.sin(rad) * (radius - 4)
            x2 = dial_cx + math.cos(rad) * radius
            y2 = dial_cy - math.sin(rad) * radius
            p.setPen(QPen(QColor("#8ABDE0"), 1))
            p.drawLine(int(x1), int(y1), int(x2), int(y2))

        # Needle rests at zero until a real speed value is decoded
        p.setPen(QPen(QColor("#FF5A66"), 2))
        p.drawLine(
            int(dial_cx),
            int(dial_cy),
            int(dial_cx - radius * 0.72),
            int(dial_cy + radius * 0.20),
        )

        p.setPen(QPen(QColor("#DCE8F7"), 1))
        p.setBrush(QColor("#39C5FF"))
        p.drawEllipse(QRectF(dial_cx - 2, dial_cy - 2, 4, 4))

        # Honest placeholder: no fabricated speed reading
        p.setPen(QColor("#FFFFFF"))
        p.setFont(QFont(self.font().family(), max(7, int(dial_size * 0.20)), QFont.Weight.Bold))
        p.drawText(
            QRectF(dial_cx - dial_size * 0.35, dial_cy + dial_size * 0.08,
                   dial_size * 0.70, dial_size * 0.25),
            Qt.AlignmentFlag.AlignCenter,
            "--",
        )
        p.setPen(QColor("#8ABDE0"))
        p.setFont(QFont(self.font().family(), max(5, int(dial_size * 0.105))))
        p.drawText(
            QRectF(dial_cx - dial_size * 0.35, dial_cy + dial_size * 0.29,
                   dial_size * 0.70, dial_size * 0.16),
            Qt.AlignmentFlag.AlignCenter,
            "km/h",
        )

        p.setPen(QColor("#9FB4CE"))
        p.drawText(QRectF(left, top - 18, car_w, 16), Qt.AlignmentFlag.AlignCenter, "FRONT")

        zone = self._zone_for_alert(self.latest_alert)
        severity = str((self.latest_alert or {}).get("severity", "medium")).lower()
        color = QColor(severity_color(severity))
        self.zone_rects = {
            "engine": QRectF(left + car_w*.18, top + car_h*.06, car_w*.64, car_h*.16),
            "steering": QRectF(left + car_w*.25, top + car_h*.25, car_w*.50, car_h*.13),
            "speed": QRectF(left + car_w*.34, top + car_h*.40, car_w*.32, car_h*.10),
            "infotainment": QRectF(left + car_w*.28, top + car_h*.52, car_w*.44, car_h*.12),
            "temperature": QRectF(left + car_w*.58, top + car_h*.08, car_w*.22, car_h*.12),
            "brake": QRectF(left - wheel_w*.42, top + car_h*.16, car_w + wheel_w*.84, car_h*.67),
        }
        if zone:
            rect = self.zone_rects.get(zone)
            if rect:
                # Layered translucent outlines create a soft glow without extra dependencies.
                for pad, alpha, width in ((9, 28, 8), (5, 55, 4), (1, 90, 2)):
                    p.setPen(QPen(QColor(color.red(), color.green(), color.blue(), alpha), width))
                    p.setBrush(Qt.BrushStyle.NoBrush)
                    p.drawRoundedRect(rect.adjusted(-pad, -pad, pad, pad), 9, 9)
                p.setPen(QPen(color, 2))
                p.setBrush(QColor(color.red(), color.green(), color.blue(), 65))
                p.drawRoundedRect(rect, 8, 8)

        legend_x = min(w * .73, cx + car_w*.65)
        legend_y = max(24, top + 8)
        p.setFont(QFont(self.font().family(), 9))
        for key, (_, label) in self.ZONES.items():
            active = key == zone
            p.setPen(QColor(color if active else QColor("#8EA6C2")))
            prefix = "● " if active else "○ "
            p.drawText(int(legend_x), int(legend_y), prefix + label)
            legend_y += 25
        if self.latest_alert:
            cid = str(self.latest_alert.get("suspect_id", "Unknown"))
            p.setPen(color)
            p.drawText(10, h - 10, f"LATEST: {cid}  |  {severity.upper()}")
        else:
            p.setPen(QColor("#8EA6C2"))
            p.drawText(10, h - 10, "NO DETECTOR ALERT LOADED")
        p.end()

    def mousePressEvent(self, event):
        if not self.latest_alert:
            return
        zone = self._zone_for_alert(self.latest_alert)
        if zone:
            self.system_clicked.emit(zone)


class Dashboard(QMainWindow):
    TAB_OVERVIEW, TAB_TRAFFIC, TAB_ALERTS = 0, 1, 2
    
    def update_live_labels(self, connected):
        if connected:
            self.setWindowTitle("CAN-Sentinel Dashboard (LIVE)")
            self.footer_label.setText(
                "CAN-SENTINEL  •  AUTOMOTIVE SECURITY MONITORING"
                "  |  CONNECTED TO LIVE CAN"
            )
            self.source_status.setText(
                f"Live CAN feed | {len(self.live_frames)} frames buffered"
            )
            self.traffic_hint.setText(
                "Live CAN frames received from the connected sniffer."
            )
            self.traffic_badge.setText("LIVE CAN FRAMES ONLY | ECU SIMULATOR (LIVE)")
        else:
            self.setWindowTitle("CAN-Sentinel Dashboard (RECORDED)")
            self.footer_label.setText(
                "CAN-SENTINEL  •  AUTOMOTIVE SECURITY MONITORING"
                "  |  RECORDED DATA MODE"
            )
            self.source_status.setText(
            "Recorded file: normal_run2_1025.csv | 100 recent rows | NOT LIVE"
            )
            self.traffic_hint.setText(
                "Recorded CSV rows only — this view displays recorded CSV data."
            )
            self.traffic_badge.setText("RECORDED DATA MODE")
    # ------------------------------------------------------------------ data
    def handle_live_frame(self, frame):
        self.live_frames.append(frame)
        self.live_mode = True
        self.update_live_labels(connected=True)
        self.live_fps_count += 1

        self.mode_label.setText(
            "LIVE CAN FEED  •  CONNECTED  |  Receiving frames from CAN sniffer"
        )
    def refresh_live_table(self):
        if not self.live_frames:
            return

        rows = [
            (
                f"{float(item['timestamp']):.6f}",
                item["can_id"],
                str(item["dlc"]),
                item["data_hex"],
                "RECEIVED"
            )
            for item in reversed(self.live_frames)
          ]
        # Update CAN Traffic table
        self._populate_table(self.traffic_table, rows)
        # Update system health and CAN ID traffic share from live frames
        self._update_analysis(rows)
        self.current_rows = rows
        self.filter_traffic_table()
        # Update Overview table with the latest 5 frames
        self._populate_table(self.overview_table, rows[:5])
    
        
        self.statusBar().showMessage(
        f"Live CAN traffic | {len(self.live_frames)} frames buffered"
        )

    def handle_connection_status(self, connected, message):
        print(f"[SOCKET DEBUG] connected={connected}, message={message}")

        if connected:
            self.update_live_labels(connected=True)
            self.mode_label.setText(
                "LIVE CAN FEED  •  CONNECTED  |  Connected to CAN sniffer"
            )
        else:
            self.live_mode = False
            self.live_frames.clear()
            self.live_fps_count = 0
            self.live_fps_samples.clear()
            self.refresh_live_data(force=True)
            self.update_live_labels(connected=False)
            self.mode_label.setText(
                "LIVE CAN FEED  •  DISCONNECTED  |  Waiting for CAN sniffer"
            )

        self.statusBar().showMessage(message)

    def refresh_live_data(self, force=False):
        """Refresh the latest recorded CSV; never implies live CAN detection.

        The 1-second timer skips work while "Pause refresh" is on; the
        Refresh button and F5 pass force=True.
        """
        # Do not overwrite live CAN data with recorded CSV data
        if getattr(self, "live_mode", False):
            return

        if self.paused and not force:
            return
        try:
            path = find_recording(DATA_DIR)
            recording = load_recording(path, n=100)
            if recording:
                rows, fps, filename, clock_steps = recording
                self.current_recording_name = filename
                self.current_clock_steps = clock_steps

                # Update recorded FPS on every refresh
                self.current_fps = f"{fps:.0f}"
                self.fps_card.value_label.setText(self.current_fps)
                self.source_status.setText(
                    f"Recorded file: {filename} | {len(rows)} recent rows | NOT LIVE"
                )
                # Only rebuild tables/bars when the data changed, so a
                # selected row or hovered bar is not reset every second.
                if rows != self._last_rows or force:
                    self._last_rows = list(rows)
                    self.current_rows = list(rows)

                    # Populate CAN Traffic table
                    self._populate_table(self.traffic_table, rows)
                    self.filter_traffic_table()

                    # Update Overview table
                    self._populate_table(self.overview_table, rows[:5])

                    # Update System Health cards and CAN-ID distribution
                    self._update_analysis(rows)

                if not self.live_mode:
                    self.fps_chart.set_series([], None)
                    self.chart_stats.setText(
                        "Waiting for live CAN frames..."
                    )
            else:
                self.source_status.setText(
                    "No valid data/normal_run*_*.csv recording found. Showing startup/sample rows."
                )
            self.last_refresh.setText(
                "UI refresh: " + datetime.datetime.now().strftime("%H:%M:%S")
                + ("  (auto-refresh paused)" if self.paused else "")
            )
        except Exception as e:
            print(f"Dashboard refresh error: {e}")
            if hasattr(self, "source_status"):
                self.source_status.setText(f"Refresh error: {e}")
    def update_live_fps(self):
        if not self.live_mode:
            return

        now = time.monotonic()
        elapsed = now - self.live_fps_last_tick

        if elapsed < 1.0:
            return

        fps = self.live_fps_count / elapsed
        self.live_fps_count = 0
        self.live_fps_last_tick = now

        self.live_fps_samples.append(fps)

        average_fps = sum(self.live_fps_samples) / len(self.live_fps_samples)

        self.fps_card.value_label.setText(f"{fps:.0f}")
        self.fps_chart.set_series(
            list(self.live_fps_samples),
            average_fps
        )

        self.chart_stats.setText(
            f"Live capture | Current: {fps:.0f} FPS | Average: {average_fps:.1f} FPS"
        )

        self.last_refresh.setText(
            f"UI refresh: {time.strftime('%H:%M:%S')}"
        )
    
    def _update_analysis(self, rows):
        """Update CAN-ID statistics, horizontal bars and doughnut chart."""
        if not hasattr(self, "analysis_bars"):
            return

        total = len(rows)
        counts = {}

        for row in rows:
            can_id = str(row[1])
            counts[can_id] = counts.get(can_id, 0) + 1

        alert_rows = sum(
            1 for row in rows if str(row[4]).upper() == "ALERT"
        )

        self.analysis_frames_card.value_label.setText(str(total))
        self.analysis_ids_card.value_label.setText(str(len(counts)))
        self.analysis_alerts_card.value_label.setText(str(alert_rows))

        top = sorted(
            counts.items(),
            key=lambda item: item[1],
            reverse=True
        )[:8]

        # Clear and rebuild only the horizontal bars.
        while self.analysis_bars.count():
            item = self.analysis_bars.takeAt(0)
            widget = item.widget()
            if widget is not None:
                widget.deleteLater()

        if not top:
            empty = QLabel("Waiting for CAN traffic...")
            empty.setObjectName("muted")
            self.analysis_bars.addWidget(empty)

            if hasattr(self, "analysis_donut"):
                self.analysis_donut.set_data([], 0)
            return

        for can_id, count in top:
            row_widget = ClickableFrame()
            row_widget.setCursor(Qt.CursorShape.PointingHandCursor)
            row_widget.setToolTip(
                f"Click to filter CAN Traffic by {can_id}"
            )
            row_widget.setStyleSheet(
                "ClickableFrame:hover {"
                "background-color: #122238; border-radius: 6px;}"
            )
            row_widget.clicked.connect(
                lambda cid=can_id: self.filter_by_id(cid)
            )

            row_layout = QHBoxLayout(row_widget)
            row_layout.setContentsMargins(4, 2, 4, 2)
            row_layout.setSpacing(10)

            label = QLabel(
                f"{can_id}  ·  {ecu_name(can_id) or 'unknown ECU'}"
            )
            label.setMinimumWidth(180)
            label.setStyleSheet("color: #DCE8F7;")

            bar = QProgressBar()
            bar.setRange(0, max(total, 1))
            bar.setValue(count)
            bar.setTextVisible(False)
            bar.setFixedHeight(12)
            bar.setStyleSheet(
                "QProgressBar {"
                "background:#172D46; border:0; border-radius:6px;}"
                "QProgressBar::chunk {"
                "background:#20B8FF; border-radius:6px;}"
            )

            value = QLabel(
                f"{count}  ({count / max(total, 1) * 100:.1f}%)"
            )
            value.setMinimumWidth(95)
            value.setStyleSheet("color: #8EA6C2;")

            row_layout.addWidget(label)
            row_layout.addWidget(bar, 1)
            row_layout.addWidget(value)

            self.analysis_bars.addWidget(row_widget)

        # Update the doughnut with exactly the same data.
        if hasattr(self, "analysis_donut"):
            self.analysis_donut.set_data(top, total)


    def _populate_table(self, table, rows):
        sorting_was_enabled = table.isSortingEnabled()

        table.setSortingEnabled(False)
        table.setUpdatesEnabled(False)

        try:
            table.setRowCount(len(rows))

            for r, row in enumerate(rows):
                system = ecu_name(row[1])

                shown = (
                    row[0],
                    row[1],
                    system or "not in baseline",
                    row[2],
                    row[3],
                    row[4]
                )

                for c, value in enumerate(shown):
                    item = QTableWidgetItem(str(value))

                    if c == 2 and system is None:
                        item.setForeground(QColor("#FFB547"))

                    if c == 5:
                        if value == "ALERT":
                            item.setForeground(QColor("#FF5A66"))
                            item.setText("●  ALERT")

                        elif value == "RECEIVED":
                            item.setForeground(QColor("#58B9FF"))
                            item.setText("●  RECEIVED")

                        else:
                            item.setForeground(QColor("#35E58B"))
                            item.setText("●  OK")

                    table.setItem(r, c, item)

        finally:
            table.setUpdatesEnabled(True)
            table.setSortingEnabled(sorting_was_enabled)
    def refresh_alerts(self):
        """Refresh severity totals and show the newest live detector alert."""
        global ALERT
        alerts = load_alerts(ALERT_FILE)
        counts = Counter(str(item.get("severity", "unknown")).lower() for item in alerts)
        for severity_name, card in getattr(self, "severity_cards", {}).items():
            card.value_label.setText(str(counts.get(severity_name, 0)))
        if hasattr(self, "vehicle_widget"):
            self.vehicle_widget.set_alerts(alerts)
        if not alerts:
            if hasattr(self, "vehicle_status_label"):
                self.vehicle_status_label.setText("No detector alerts in the live alert log. No vehicle region is highlighted.")
            return

        latest = alerts[-1]
        if hasattr(self, "vehicle_status_label"):
            self.vehicle_status_label.setText(
                f"Latest finding: {latest.get('attack_type', 'Unknown')} on "
                f"{latest.get('suspect_id', 'Unknown')} · "
                f"{str(latest.get('severity', 'unknown')).upper()} · "
                f"{latest.get('affected_system', 'Unknown')}. "
                "Subsystem glow is a CAN-ID mapping, not physical fault localization."
            )
        if latest == ALERT:
            return

        ALERT = latest
        self.alert_summary = (
            "LIVE DETECTOR ALERT — RULES-BASED FINDING\n"
            f"Source: {ALERT_FILE.name}\n"
            "Verification: Live CAN stream; rule-based detection (not ML-confirmed)\n\n"
            f"Type: {latest.get('attack_type', 'Unknown')}\n"
            f"CAN ID: {latest.get('suspect_id', 'Unknown')}\n"
            f"Severity: {latest.get('severity', 'Unknown')}\n"
            f"Confidence: {latest.get('confidence', 0):.2f}\n"
            f"Affected system: {latest.get('affected_system', 'Unknown')}\n"
            f"Detection layer: {latest.get('detection_layer', 'Unknown')}\n"
            f"Technique: {latest.get('technique', 'Unknown')}"
        )
        self.alert_details.setText(self.alert_summary)
        if hasattr(self, "alert_banner_detail"):
            e = html.escape
            sev = str(latest.get("severity", "unknown"))
            sev_col = severity_color(sev)
            self.alert_banner_detail.setText(
                f'<span style="color:#FF5A66;font-weight:bold;">'
                f'{e(str(latest.get("attack_type", "Unknown")))} on '
                f'{e(str(latest.get("suspect_id", "Unknown")))}</span>'
                f'<span style="color:#DCE8F7;">  |  '
                f'confidence {float(latest.get("confidence", 0)):.2f}  |  '
                f'{e(str(latest.get("affected_system", "Unknown")))}  |  '
                f'severity </span>'
                f'<span style="color:{sev_col};font-weight:bold;">{e(sev)}</span>'
            )
        self.review_button.setEnabled(True)
        self.alert_quarantine_button.setEnabled(True)

    def show_vehicle_system_details(self, system):
        """Show which latest alert is associated with the selected vehicle zone."""
        alerts = load_alerts(ALERT_FILE)
        matches = [item for item in alerts if VehicleThreatWidget._zone_for_alert(item) == system]
        if not matches:
            self.vehicle_status_label.setText(f"{system.title()}: no matching detector alert in the current log.")
            return
        item = matches[-1]
        self.vehicle_status_label.setText(
            f"{system.title()} · CAN ID {item.get('suspect_id', 'Unknown')} · "
            f"{item.get('attack_type', 'Unknown')} · "
            f"{str(item.get('severity', 'unknown')).upper()} · "
            f"Confidence {float(item.get('confidence', 0)):.2f}"
        )
        self.go_to(self.TAB_ALERTS)

    def quarantine_latest_alert(self):
        """Manually quarantine the CAN ID from the latest live alert."""
        alert = load_alert(ALERT_FILE)
        if not alert:
            self.gateway_control_status.setText("No valid live alert to quarantine.")
            return

        self.gateway_can_id_input.setText(str(alert["suspect_id"]))
        self.gateway_mode_combo.setCurrentText("drop")
        self.gateway_duration_input.setText("30")
        self.quarantine_gateway_id()

    # ------------------------------------------------------- gateway events
    def send_gateway_command(self, command):
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
                sock.settimeout(3)
                sock.connect("/tmp/can_sentinel_gw.sock")
                sock.sendall((json.dumps(command) + "\n").encode())
                response = json.loads(sock.recv(4096).decode())

            if response.get("ok"):
                self.gateway_control_status.setText("Success: " + str(response))
                self.refresh_gateway_events()
            else:
                self.gateway_control_status.setText(
                    "Gateway rejected command: " + response.get("error", "Unknown error")
                )
        except Exception as exc:
            self.gateway_control_status.setText("Gateway connection error: " + str(exc))

    def quarantine_gateway_id(self):
        can_id = self.gateway_can_id_input.text().strip()
        try:
            duration = float(self.gateway_duration_input.text())
            if duration <= 0:
                raise ValueError
        except ValueError:
            self.gateway_control_status.setText("Enter a valid positive duration.")
            return

        self.send_gateway_command({
            "type": "quarantine",
            "can_id": can_id,
            "mode": self.gateway_mode_combo.currentText(),
            "duration_s": duration,
            "reason": "Dashboard manual quarantine",
        })

    def release_gateway_id(self):
        self.send_gateway_command({
            "type": "release",
            "can_id": self.gateway_can_id_input.text().strip(),
        })

    def refresh_gateway_events(self):
        """Refresh gateway quarantine history from its JSONL event log."""
        if not hasattr(self, "gateway_table"):
            return

        events = []
        try:
            with open(GATEWAY_EVENT_FILE, "r", encoding="utf-8") as f:
                for line in f:
                    if not line.strip():
                        continue
                    try:
                        event = json.loads(line)
                    except json.JSONDecodeError:
                        # Ignore a partially written final JSONL line.
                        continue
                    if isinstance(event, dict) and event.get("event") in {
                        "quarantine_start", "quarantine_end", "frame_dropped"
                    }:
                        events.append(event)
        except OSError:
            events = []

        active = {}
        now = time.time()
        for event in events:
            can_id = str(event.get("can_id", "Unknown"))
            kind = event.get("event")
            if kind == "quarantine_start":
                try:
                    started = float(event.get("timestamp", now))
                    duration = max(0.0, float(event.get("duration_s", 0)))
                except (TypeError, ValueError):
                    started, duration = now, 0.0
                active[can_id] = {
                    "mode": str(event.get("mode", "unknown")),
                    "reason": str(event.get("reason", "—")),
                    "until": started + duration,
                }
            elif kind == "quarantine_end":
                active.pop(can_id, None)

        # Remove entries whose expiry passed even if the end line is not yet
        # present in the log (for example, while the gateway is shutting down).
        active = {cid: data for cid, data in active.items() if data["until"] > now}
        self.gateway_active_label.setText(
            f"ACTIVE QUARANTINES: {len(active)}"
        )
        self.gateway_source_label.setText(
            f"Event log: {GATEWAY_EVENT_FILE}  |  "
            f"{len(events)} lifecycle events"
        )

        rows = []
        for event in reversed(events[-200:]):
            try:
                stamp = datetime.datetime.fromtimestamp(
                    float(event.get("timestamp", 0))
                ).strftime("%Y-%m-%d %H:%M:%S")
            except (TypeError, ValueError, OSError):
                stamp = str(event.get("timestamp", "—"))
            can_id = str(event.get("can_id", "—"))
            kind = str(event.get("event", "—"))
            mode = str(event.get("mode", "—"))
            reason = str(event.get("reason", event.get("why", "—")))
            if kind == "quarantine_start":
                state = "ACTIVE" if can_id in active else "EXPIRED"
                if can_id in active:
                    seconds = max(0, int(active[can_id]["until"] - now))
                    state = f"ACTIVE · {seconds}s left"
            elif kind == "frame_dropped":
                payload = str(event.get("payload", "—"))
                reason = f"{reason} | payload: {payload}"
                state = "DROPPED"
            else:
                state = str(event.get("why", "ENDED")).upper()
            rows.append((stamp, kind, can_id, mode, reason, state))

        self.gateway_table.setRowCount(len(rows))
        for row_index, row in enumerate(rows):
            for col_index, value in enumerate(row):
                item = QTableWidgetItem(str(value))
                if col_index == 5:
                    item.setForeground(
                        QColor("#35E58B") if str(value).startswith("ACTIVE")
                        else QColor("#FFB547")
                    )
                self.gateway_table.setItem(row_index, col_index, item)
        if not events:
            self.gateway_status_label.setText(
                "No gateway events yet. The panel will update automatically "
                "when a quarantine event is written."
            )
        else:
            self.gateway_status_label.setText(
                "Gateway quarantine lifecycle events · newest first"
            )

    # ---------------------------------------------------------------- build

    def __init__(self):
        super().__init__()
        self.paused = False
        self._last_rows = None
        self.live_frames = deque(maxlen=100)
        self.live_mode = False
        self.live_fps_count = 0
        self.live_fps_last_tick = time.monotonic()
        self.live_fps_samples = deque(maxlen=300)
        self.live_ui_timer = QTimer(self)
        self.live_ui_timer.timeout.connect(self.refresh_live_table)
        self.live_ui_timer.start(100)
        self.setWindowTitle("CAN-Sentinel Dashboard (RECORDED)")
        self.resize(1440, 900)
        self.setMinimumSize(760, 560)

        self.car_pixmap = QPixmap(str(CAR_IMAGE_PATH))

        # Mirror horizontally so the car faces right to left.
        if not self.car_pixmap.isNull():
            self.car_pixmap = self.car_pixmap.transformed(
                QTransform().scale(-1, 1)
            )

        root = QWidget()
        root.setObjectName("root")

        outer_layout = QVBoxLayout(root)
        outer_layout.setContentsMargins(0, 0, 0, 0)
        outer_layout.setSpacing(0)

        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setHorizontalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAsNeeded
        )
        scroll.setVerticalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAsNeeded
        )

        content = QWidget()
        content.setObjectName("content")

        page = QVBoxLayout(content)
        page.setContentsMargins(24, 18, 24, 18)
        page.setSpacing(12)

        # ---------------- Hero: title, cards, gauge over the car ----------------

        hero = HeroPanel(self.car_pixmap)
        hero.setMinimumHeight(340)
        hero.setMaximumHeight(400)

        hero_layout = QVBoxLayout(hero)
        hero_layout.setContentsMargins(0, 8, 0, 8)
        hero_layout.setSpacing(12)

        subtitle = QLabel("Automotive ECU intrusion detection")
        subtitle.setObjectName("sub")

        # Honest mode banner: says exactly where the numbers came from.
        if USING_FILES:
            parts = []
            parts.append(
                f"traffic: {RECORDING_NAME}" if RECORDING_NAME
                else "traffic: sample rows"
            )
            if CLOCK_STEPS:
                parts.append(f"timestamp clock steps in file: {CLOCK_STEPS}")
            parts.append(
                f"alert: {ALERT_FILE.name} (sample; not ML-verified)"
                if IS_SAMPLE_ALERT
                else f"alert: {ALERT_FILE.name} (loaded; detection not verified)"
                if ALERT
                else "alert: none loaded"
            )
            mode_text = "REPLAYING RECORDED FILE  •  NOT LIVE  |  " + "  |  ".join(parts)
        else:
            mode_text = "DEMO MODE  •  STATIC SAMPLE DATA"

        self.mode_label = QLabel(mode_text)
        self.mode_label.setObjectName("muted")
        self.mode_label.setWordWrap(True)

        hero_layout.addWidget(subtitle)
        hero_layout.addWidget(self.mode_label)

        # ---------------- Three summary cards (click to jump) ----------------

        name, color = threat_level(THREAT)

        cards = QHBoxLayout()
        cards.setSpacing(12)

        self.fps_card = make_card(
            "Frames / second", FRAMES_PER_SECOND, "#39C5FF",
            tip="Open CAN Traffic",
        )
        self.alerts_card = make_card(
            "Alerts loaded" + SAMPLE_TAG, ALERT_COUNT, "#FFB547",
            tip="Open Alerts",
        )
        self.threat_card = make_card(
            "Threat level" + SAMPLE_TAG, name, color,
            tip="Open Alerts",
        )
        self.fps_card.clicked.connect(lambda: self.go_to(self.TAB_TRAFFIC))
        self.alerts_card.clicked.connect(lambda: self.go_to(self.TAB_ALERTS))
        self.threat_card.clicked.connect(lambda: self.go_to(self.TAB_ALERTS))
        cards.addWidget(self.fps_card)
        cards.addWidget(self.alerts_card)
        cards.addWidget(self.threat_card)

        hero_layout.addLayout(cards)
        hero.setMinimumHeight(250)     # was 340
        hero.setMaximumHeight(270)     # was 400
        # ---------------- Threat score gauge ----------------

        threat_row = QHBoxLayout()
        threat_row.setSpacing(12)

        score_title = QLabel("THREAT SCORE" + (" (SAMPLE)" if IS_SAMPLE_ALERT else ""))
        score_title.setStyleSheet(
            "color: #A9BED7; font-size: 12px; font-weight: bold;"
        )

        zero_label = QLabel("0")
        zero_label.setStyleSheet("color: #8EA6C2;")

        gauge = QProgressBar()
        gauge.setRange(0, 100)
        gauge.setValue(THREAT)
        gauge.setTextVisible(False)
        gauge.setToolTip(f"Threat score {THREAT} / 100")
        gauge.setStyleSheet(
            f"QProgressBar::chunk {{ background-color: {color}; }}"
        )

        score_value = QLabel(f"{THREAT} / 100")
        score_value.setStyleSheet(
            "color: #C8D8EB; font-size: 13px; font-weight: bold;"
        )

        threat_row.addWidget(score_title)
        threat_row.addWidget(zero_label)
        threat_row.addWidget(gauge, 1)
        threat_row.addWidget(score_value)

        hero_layout.addLayout(threat_row)

        page.addWidget(hero, 1)

        # ---------------- Main dashboard columns ----------------
        overview_row = QHBoxLayout()
        overview_row.setSpacing(12)

        main_column = QVBoxLayout()
        main_column.setSpacing(12)

        side_column = QVBoxLayout()
        side_column.setSpacing(12)

        overview_row.addLayout(main_column, 3)
        overview_row.addLayout(side_column, 2)

        # ---------------- Latest alert banner (click to open Alerts) ----------------

        alert_card = ClickableFrame()
        alert_card.setCursor(Qt.CursorShape.PointingHandCursor)
        alert_card.setToolTip("Open Alerts")
        alert_card.clicked.connect(lambda: self.go_to(self.TAB_ALERTS))
        alert_layout = QHBoxLayout(alert_card)
        alert_layout.setContentsMargins(16, 10, 16, 10)
        alert_layout.setSpacing(12)

        alert_icon = QLabel()
        alert_icon.setAlignment(Qt.AlignmentFlag.AlignCenter)
        alert_icon.setFixedSize(46, 46)

        alert_text = QVBoxLayout()

        self.alert_title = QLabel(
            "Latest alert  —  SAMPLE ALERT, not a detection"
            if IS_SAMPLE_ALERT else "Latest alert"
        )
        self.alert_title.setStyleSheet("color: #B7C8DB; font-size: 12px;")
        if IS_SAMPLE_ALERT:
            self.alert_title.setText(
                "Latest alert  —  ⚠ SAMPLE DATA (NOT A REAL DETECTION)"
            )
            self.alert_title.setStyleSheet(
                "color: #FFB547; font-size: 12px; font-weight: bold;"
            )
        alert_detail = QLabel()
        alert_detail.setTextFormat(Qt.TextFormat.RichText)
        alert_detail.setWordWrap(True)
        alert_detail.setStyleSheet("font-size: 15px;")

        if ALERT:
            alert_card.setObjectName("alertCard")
            alert_icon.setText("!")
            alert_icon.setStyleSheet(
                "background-color: #3B1C2A;"
                "color: #FF5A66;"
                "border-radius: 10px;"
                "font-size: 28px;"
                "font-weight: bold;"
            )

            sev = str(ALERT["severity"])
            sev_col = severity_color(sev)
            e = html.escape  # file content is untrusted; escape before rich text

            alert_detail.setText(
                f'<span style="color:#FF5A66;font-weight:bold;">'
                f'{e(str(ALERT["attack_type"]))} on {e(str(ALERT["suspect_id"]))}</span>'
                f'<span style="color:#DCE8F7;">'
                f'  |  confidence {ALERT["confidence"]:.2f}'
                f'  |  {e(str(ALERT["affected_system"]))}'
                f'  |  layer {e(str(ALERT["detection_layer"]))}'
                f'  |  {e(str(ALERT["technique"]))}'
                f'  |  severity </span>'
                f'<span style="color:{sev_col};font-weight:bold;">{e(sev)}</span>'
            )
        else:
            alert_card.setObjectName("alertCardEmpty")
            alert_icon.setText("✓")
            alert_icon.setStyleSheet(
                "background-color: #12372A;"
                "color: #35E58B;"
                "border-radius: 10px;"
                "font-size: 28px;"
                "font-weight: bold;"
            )
            alert_detail.setText(
                '<span style="color:#35E58B;font-weight:bold;">No alerts</span>'
            )

        alert_text.addWidget(self.alert_title)
        alert_text.addWidget(alert_detail)

        alert_layout.addWidget(alert_icon)
        alert_layout.addLayout(alert_text, 1)

        main_column.addWidget(alert_card)

        # ---------------- Live severity totals + vehicle threat map ----------------
        threat_map_card = QFrame()
        threat_map_card.setObjectName("trafficCard")
        threat_map_layout = QVBoxLayout(threat_map_card)
        threat_map_layout.setContentsMargins(14, 12, 14, 12)
        threat_map_layout.setSpacing(8)
        threat_map_heading = QLabel("LIVE VEHICLE THREAT MAP")
        threat_map_heading.setStyleSheet("color:#E8F2FF;font-size:14px;font-weight:bold;")
        threat_map_layout.addWidget(threat_map_heading)

        severity_row = QHBoxLayout()
        severity_row.setSpacing(8)
        self.severity_cards = {}
        for severity_name, severity_hex in (("critical", "#FF5A66"), ("high", "#FF8A4D"), ("medium", "#FFB547"), ("low", "#35E58B")):
            severity_card = make_card(severity_name.title() + " alerts", "0", severity_hex, size=22)
            self.severity_cards[severity_name] = severity_card
            severity_row.addWidget(severity_card)
        threat_map_layout.addLayout(severity_row)

        self.vehicle_widget = VehicleThreatWidget()
        self.vehicle_widget.system_clicked.connect(self.show_vehicle_system_details)
        threat_map_layout.addWidget(self.vehicle_widget)
        self.vehicle_status_label = QLabel("Waiting for a live detector alert. Highlighting is based on CAN-ID-to-subsystem mapping.")
        self.vehicle_status_label.setObjectName("muted")
        self.vehicle_status_label.setWordWrap(True)
        threat_map_layout.addWidget(self.vehicle_status_label)
        side_column.addWidget(threat_map_card)

        # ---------------- Recent CAN traffic: graph + minimised table ----------------

        traffic_card = QFrame()
        traffic_card.setObjectName("trafficCard")

        traffic_layout = QVBoxLayout(traffic_card)
        traffic_layout.setContentsMargins(12, 9, 12, 10)
        traffic_layout.setSpacing(8)

        traffic_heading = QHBoxLayout()

        traffic_icon = QLabel("▤")
        traffic_icon.setStyleSheet(
            "color: #7EC8FF; font-size: 20px;"
        )

        traffic_title = QLabel("RECENT CAN TRAFFIC")
        traffic_title.setStyleSheet(
            "color: #E8F2FF; font-size: 14px; font-weight: bold;"
        )

        badge_text = "LIVE CAN FRAMES ONLY | ECU SIMULATOR (LIVE)"
        self.traffic_badge = QLabel(badge_text)
        self.traffic_badge.setSizePolicy(
            QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Fixed
        )
        self.traffic_badge.setStyleSheet(
            "color: #8FA9C5;"
            "background-color: #172D46;"
            "padding: 5px 8px;"
            "border-radius: 6px;"
            "font-size: 10px;"
            "font-weight: bold;"
        )

        self.table_toggle = QPushButton("Hide table")
        self.table_toggle.setToolTip("Minimise the table so the graph gets the full width")
        self.table_toggle.clicked.connect(self.toggle_overview_table)

        traffic_heading.addWidget(traffic_icon)
        traffic_heading.addWidget(traffic_title)
        traffic_heading.addStretch(1)
        traffic_heading.addWidget(self.traffic_badge)
        traffic_heading.addWidget(self.table_toggle)

        traffic_layout.addLayout(traffic_heading)

        traffic_body = QHBoxLayout()
        traffic_body.setSpacing(12)

        # Left: frames-per-second graph with range buttons.
        chart_box = QVBoxLayout()
        chart_box.setSpacing(6)
        chart_top = QHBoxLayout()
        chart_title = QLabel("FRAMES PER SECOND")
        chart_title.setStyleSheet("color: #A9BED7; font-size: 12px; font-weight: bold;")
        chart_top.addWidget(chart_title)
        chart_top.addStretch(1)
        self.range_group = QButtonGroup(self)
        self.fps_chart = FpsChart()
        for text, seconds, checked in (("30 s", 30, False), ("60 s", 60, True), ("All", 0, False)):
            b = QPushButton(text)
            b.setCheckable(True)
            b.setChecked(checked)
            b.setFixedWidth(52)
            self.range_group.addButton(b)
            b.clicked.connect(lambda _c, s=seconds: self.fps_chart.set_window(s))
            chart_top.addWidget(b)
        self.chart_stats = QLabel("Waiting for live CAN frames...")
